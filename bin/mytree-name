#!/usr/bin/env php
<?php

declare(strict_types=1);

$root = dirname(__DIR__);
require $root . '/bootstrap.php';

use MyTree\NameProcessing\Application\DefaultRegistryFactory;
use MyTree\NameProcessing\Cli\CliApplication;

$app = new CliApplication(DefaultRegistryFactory::create($root));
exit($app->run($argv));
